KOKKOPI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kokkopi
KOKKOPI_JWT_SECRET=change-me-to-a-long-random-secret
KOKKOPI_ENCRYPTION_KEY=
KOKKOPI_ALLOWED_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
KOKKOPI_ASR_MODEL=small
KOKKOPI_VRAM_BUDGET_MB=6000
KOKKOPI_TEXT_NORMALIZATION=1
KOKKOPI_VOICE_PROFILES_DIR=/tmp/kokkopi_voice_profiles
